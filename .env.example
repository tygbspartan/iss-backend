# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL — Prisma connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Default admin account — seeded on first startup if it doesn't exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Auth — at least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Storage ──────────────────────────────────────────────────────────────────
# NODE_ENV != production → Supabase Storage (bucket must be PUBLIC)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# NODE_ENV = production → local disk on the cPanel/VPS server, served at /uploads
# PUBLIC_BASE_URL is this API's public origin (no trailing slash).
# UPLOAD_DIR should live OUTSIDE the deploy folder so redeploys don't wipe it.
PUBLIC_BASE_URL=https://api.example.com
# UPLOAD_DIR=/home/USER/iss-uploads

# ── Cache (optional) ─────────────────────────────────────────────────────────
# Redis connection URL. Leave unset to run without caching.
# Local: redis://localhost:6379   Upstash/managed (TLS): rediss://default:PASSWORD@HOST:6379
# REDIS_URL=

# ── Email (optional) ─────────────────────────────────────────────────────────
# SMTP account used to SEND notification emails. Leave unset to skip emails
# (inquiries are still saved and visible in the admin panel).
# Gmail: host smtp.gmail.com, port 587, user = the Gmail address, pass = an
# "App password" (Google Account → Security → 2-Step Verification → App passwords)
# — NOT the normal Gmail password.
# cPanel: host mail.yourdomain.com, port 465 or 587, user = the full mailbox address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" shown on the email. Defaults to SMTP_USER. Example: ISS Nepal Website <you@gmail.com>
# MAIL_FROM=
# Who receives "Contact Us" submissions. Several addresses: separate with commas.
CONTACT_NOTIFY_EMAIL=grishan.rocks@gmail.com

# ── Instagram feed (optional) ────────────────────────────────────────────────
# Access token for the company's Instagram professional account, used for the
# "On The Feed" section of the website. Leave unset to leave that section out.
# Get one: Meta for Developers → your app → Instagram → "API setup with
# Instagram business login" → Generate token (next to the account).
# You only do this ONCE. The server copies the token into the database and
# renews it itself every week, so it never reaches Instagram's 60-day expiry.
# The value here is not updated — that's expected; the database copy is the live one.
# Only if the token is ever cancelled (Instagram password changed, the app's
# access removed) do you need to generate a new one, paste it here and restart.
INSTAGRAM_ACCESS_TOKEN=
