{
  "name": "iss-be",
  "version": "1.0.0",
  "description": "ISS backend — Express + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prestart": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:services": "node dist/scripts/seed-services.js",
    "seed:services:dev": "ts-node src/scripts/seed-services.ts",
    "seed:projects": "node dist/scripts/seed-projects.js",
    "seed:projects:dev": "ts-node src/scripts/seed-projects.ts",
    "seed:team": "node dist/scripts/seed-team.js",
    "seed:team:dev": "ts-node src/scripts/seed-team.ts",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tygbspartan/iss-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tygbspartan/iss-backend/issues"
  },
  "homepage": "https://github.com/tygbspartan/iss-backend#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^16.5.4",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
